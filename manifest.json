{
	"manifest_version": 3,
	"name": "Close All Tabs Extension",
	"version": "1.0",
	"description": "An extension to close all open tabs in one click.",
	"permissions": [
	  "tabs"
	],
	"background": {
	  "service_worker": "background.js"
	},
	"action": {
	  "default_popup": "popup.html",
	  "default_icon": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	  }
	},
	"icons": {
	  "16": "icon.png",
	  "48": "icon.png",
	  "128": "icon.png"
	}
  }
  